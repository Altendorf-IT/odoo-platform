# BuildKit reads this because it sits next to platform/Dockerfile
# (<dockerfile>.dockerignore takes precedence over <context>/.dockerignore).
# Paths are relative to the build context = the PRODUCT repo root.

# === Git (645MB savings) ===
.git
**/.git
**/.gitignore
**/.gitmodules
**/.github

# === Python bytecode ===
**/__pycache__
**/*.py[cod]

# === OS / IDE ===
**/.DS_Store
.vscode
.idea

# === Vendor: strip test suites and CI config (Odoo never loads these) ===
**/tests/
**/test/
**/.travis.yml
**/.pre-commit-config.yaml
**/.pylintrc

# === Vendor: strip translation catalogs and pot templates ===
# Vendor catalogs are dead weight (we run one or two languages), but the
# product's OWN catalogs are the product: without them a first-party module
# ships English-only and nobody notices until it is in front of the customer.
**/i18n/
**/*.pot
!src/custom_addons/**/i18n
!src/custom_addons/**/i18n/**
# organize_urself is ours too, only vendored: its catalogs are the product.
!src/third_party_addons/_vendor/organize_urself/**/i18n
!src/third_party_addons/_vendor/organize_urself/**/i18n/**

# === Docs not needed at runtime ===
**/doc/
**/docs/
**/*.md
.weblate.json

# === Local dev artifacts ===
.env
*.log
odoo.conf
backups/

# === Build machinery not needed inside the image ===
docker-compose.yml
Makefile
selection.txt
platform/docker-compose.override.yml
platform/docker-compose.nginx.yml
platform/deploy/
platform/Makefile
platform/scripts/
# ...except the two dependency helpers the build itself needs: the collector
# the pip layer bind-mounts, and the guard that verifies the result.
!platform/scripts/manifest-pydeps.py
!platform/scripts/check-pydeps.py
